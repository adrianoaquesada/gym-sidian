{
  "name": "gym-stone",
  "version": "1.0.6",
  "description": "Sistema de rutinas de gimnasio para Obsidian.",
  "author": "adrianoaquesada",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "review": "npm run lint && npm run build && npm audit",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": [
    "obsidian",
    "gimnasio",
    "rutinas",
    "entrenamiento"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.10.9",
    "esbuild": "^0.25.9",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "latest",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "moment": "^2.31.0"
  }
}
